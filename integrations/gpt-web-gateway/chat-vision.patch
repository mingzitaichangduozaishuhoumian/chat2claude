+++ b/scripts/test-chat-vision.js
@@ -0,0 +1,332 @@
+'use strict';
+
+// Parser and actual HTTP routes; the ChatGPT browser boundary is stubbed so no
+// model calls, login, or browser installation are needed.
+const assert = require('assert');
+const http = require('http');
+const Module = require('module');
+const {
+  MAX_CHAT_REQUEST_BYTES, MAX_CHAT_IMAGE_BYTES, IMAGE_ONLY_PROMPT,
+  normalizeChatMessages, normalizeResponsesInput, assertChatRequestSize,
+} = require('../src/lib/chat-vision.cjs');
+
+const PNG = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aI1sAAAAASUVORK5CYII=', 'base64');
+const dataUrl = (buffer = PNG, mimeType = 'image/png') => `data:${mimeType};base64,${buffer.toString('base64')}`;
+const picture = (url = dataUrl()) => ({ type: 'image_url', image_url: { url } });
+const user = (content) => ({ role: 'user', content });
+const validBody = (extra = {}) => ({ messages: [user([{ type: 'text', text: 'What is this?' }, picture()])], ...extra });
+const tests = [];
+const add = (name, fn) => tests.push([name, fn]);
+const rejects = (fn) => assert.throws(fn, (err) => err.code === 'invalid_request' && !err.message.includes('base64,iVBO'));
+const imageNamePattern = (extension) => new RegExp(`^chat-vision-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.${extension}$`);
+
+add('one latest user image preserves text order and actual MIME metadata', () => {
+  const result = normalizeChatMessages([
+    { role: 'system', content: 'Follow instructions' },
+    { role: 'assistant', content: 'Earlier reply' },
+    user(['first', picture(), { type: 'text', text: 'second' }]),
+  ]);
+  assert.strictEqual(result.text, 'System instructions:\nFollow instructions\n\nPrevious assistant message:\nEarlier reply\n\nUser:\nfirst\nsecond');
+  assert.match(result.image.name, imageNamePattern('png'));
+  assert.deepStrictEqual({ mimeType: result.image.mimeType, buffer: result.image.buffer }, { mimeType: 'image/png', buffer: PNG });
+  const repeatedNames = Array.from({ length: 20 }, () => normalizeChatMessages([user([picture()])]).image.name);
+  assert.strictEqual(new Set([result.image.name, ...repeatedNames]).size, 21, 'every parse must use a new filename even for identical bytes');
+  for (const name of repeatedNames) assert.match(name, imageNamePattern('png'));
+  assert.strictEqual(normalizeChatMessages([user([picture()])]).text, `User:\n${IMAGE_ONLY_PROMPT}`);
+  const formats = [
+    ['image/jpeg', 'jpg', Buffer.from([255, 216, 255, 224])],
+    ['image/webp', 'webp', Buffer.from('RIFF0000WEBP')],
+    ['image/gif', 'gif', Buffer.from('GIF89a')],
+  ];
+  for (const [mime, ext, bytes] of formats) {
+    const image = normalizeChatMessages([user([picture(dataUrl(bytes, mime))])]).image;
+    assert.match(image.name, imageNamePattern(ext));
+    assert.strictEqual(image.mimeType, mime);
+    assert.deepStrictEqual(image.buffer, bytes);
+  }
+});
+
+add('legacy text, string parts, and input precedence remain compatible', () => {
+  assert.strictEqual(normalizeChatMessages([user(['a', { text: 'b' }, { type: 'text', content: 'c' }])]).text, 'User:\na\nb\nc');
+  assert.strictEqual(normalizeChatMessages([user('old')], 'direct input').text, 'direct input');
+  assert.strictEqual(normalizeChatMessages(null, [user('fallback')]).text, 'User:\nfallback');
+  assert.strictEqual(normalizeChatMessages([]).text, '');
+  assert.strictEqual(normalizeResponsesInput(null, 'direct').text, 'direct');
+  assert.strictEqual(normalizeResponsesInput(null, [user([{ type: 'input_text', text: 'hello' }])]).text, 'User:\nhello');
+});
+
+add('history, assistant, system, missing role, duplicate, or ambiguous images reject', () => {
+  for (const messages of [
+    [user([picture()]), user('later')],
+    [{ role: 'assistant', content: [picture()] }],
+    [{ role: 'system', content: [picture()] }],
+    [{ content: [picture()] }],
+    [user([picture(), picture()])],
+  ]) rejects(() => normalizeChatMessages(messages));
+  rejects(() => normalizeChatMessages([user([picture()])], 'overrides'));
+  rejects(() => normalizeChatMessages(null, [user([picture()])]));
+});
+
+add('remote, malformed, noncanonical, unsupported, mismatched and oversized images reject', () => {
+  for (const url of [
+    'https://example.invalid/image.png', 'file:///image.png',
+    'data:image/svg+xml;base64,PHN2Zz4=', 'data:image/png;base64,',
+    'data:image/png;base64,AA=A', 'data:image/png;base64,AAAA\n',
+    'data:image/png;base64,AAAAA', 'data:image/png;base64,AB==',
+    dataUrl(PNG, 'image/jpeg'), 'data:image/png;base64,SGVsbG8=',
+  ]) rejects(() => normalizeChatMessages([user([picture(url)])]));
+  rejects(() => normalizeChatMessages([user([{ type: 'image_url', image_url: {} }])]));
+  rejects(() => normalizeChatMessages([user([picture(dataUrl(Buffer.alloc(MAX_CHAT_IMAGE_BYTES + 1)))])]));
+});
+
+add('unknown content never silently disappears and Responses images always reject', () => {
+  for (const part of [{ type: 'input_audio', data: 'ignored' }, { type: 'input_image', image_url: dataUrl() }, { type: 'mystery', text: 'ignored' }, null, 42]) {
+    rejects(() => normalizeChatMessages([user([part])]));
+  }
+  for (const input of [[user([picture()])], [{ type: 'input_image', image_url: dataUrl() }]]) {
+    rejects(() => normalizeResponsesInput(null, input));
+    rejects(() => normalizeResponsesInput(input, 'otherwise overrides'));
+  }
+  rejects(() => assertChatRequestSize({ input: 'x' }, MAX_CHAT_REQUEST_BYTES + 1));
+  rejects(() => assertChatRequestSize({ input: 'x'.repeat(MAX_CHAT_REQUEST_BYTES) }));
+});
+
+const bridge = { completeText: null };
+const chatgptPath = require.resolve('../src/chatgpt');
+const cached = new Module(chatgptPath);
+cached.filename = chatgptPath;
+cached.loaded = true;
+cached.exports = {
+  READ_VIA_BACKEND_API: true,
+  setPoolHooks(hooks) { bridge.poolHooks = hooks; }, recordSlotJobFinished() {},
+  completeText: (prompt, options) => bridge.completeText(prompt, options),
+  generateImage: async () => { throw new Error('unexpected image-generation route'); },
+  editImage: async () => { throw new Error('unexpected image-edit route'); },
+  probeCapabilities: async () => ({}),
+};
+require.cache[chatgptPath] = cached;
+
+function call(port, body, path = '/v1/chat/completions') {
+  const payload = JSON.stringify(body);
+  let req;
+  const promise = new Promise((resolve, reject) => {
+    req = http.request({ hostname: '127.0.0.1', port, method: 'POST', path, headers: { 'content-type': 'application/json', 'content-length': Buffer.byteLength(payload) } }, (res) => {
+      const chunks = [];
+      res.on('data', (chunk) => chunks.push(chunk));
+      res.on('end', () => {
+        const raw = Buffer.concat(chunks).toString();
+        resolve({ status: res.statusCode, headers: res.headers, raw, json: res.headers['content-type']?.includes('application/json') ? JSON.parse(raw) : null });
+      });
+    });
+    req.on('error', reject);
+    req.end(payload);
+  });
+  return { req, promise };
+}
+
+async function waitUntil(fn, label) {
+  const deadline = Date.now() + 3000;
+  while (Date.now() < deadline) {
+    if (fn()) return;
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+  throw new Error(`Timed out waiting for ${label}`);
+}
+
+async function withRouter(fn) {
+  const express = require('express');
+  const keys = ['MAX_CONCURRENT_JOBS', 'MAX_QUEUE_SIZE', 'MIN_TURN_STAGGER_SEC', 'MIN_JOB_GAP_SEC'];
+  const previous = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+  Object.assign(process.env, { MAX_CONCURRENT_JOBS: '1', MAX_QUEUE_SIZE: '5', MIN_TURN_STAGGER_SEC: '0', MIN_JOB_GAP_SEC: '0' });
+  delete require.cache[require.resolve('../src/routes/images')];
+  const app = express();
+  app.use(express.json({ limit: '50mb' }));
+  app.use(require('../src/routes/images'));
+  const server = http.createServer(app);
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  try { await fn(server.address().port); }
+  finally {
+    await new Promise((resolve) => { server.close(resolve); server.closeAllConnections(); });
+    for (const key of keys) {
+      if (previous[key] === undefined) delete process.env[key];
+      else process.env[key] = previous[key];
+    }
+  }
+}
+
+add('real JSON and SSE routes send image buffer, signal, and confirmed attachment count', async () => {
+  let calls = 0;
+  const parser = require('../src/lib/chat-vision.cjs');
+  const originalNormalize = parser.normalizeChatMessages;
+  const pendingNames = [];
+  const generatedNames = [];
+  parser.normalizeChatMessages = (...args) => {
+    const result = originalNormalize(...args);
+    if (result.image) { pendingNames.push(result.image.name); generatedNames.push(result.image.name); }
+    return result;
+  };
+  bridge.completeText = async (prompt, options) => {
+    calls += 1;
+    assert.strictEqual(prompt, 'User:\nWhat is this?');
+    assert.deepStrictEqual(options.image.buffer, PNG);
+    assert.strictEqual(options.image.mimeType, 'image/png');
+    assert.strictEqual(options.image.name, pendingNames.shift(), 'route must forward the exact filename generated by its parser');
+    assert.match(options.image.name, imageNamePattern('png'));
+    assert(options.signal instanceof AbortSignal);
+    assert.strictEqual(options.signal.aborted, false);
+    await options.beforeSubmit();
+    options.onDelta?.('A pixel.');
+    return { text: 'A pixel.', applied: { thinking: false, image_inputs_attached: 1 } };
+  };
+  try { await withRouter(async (port) => {
+    const json = await call(port, validBody()).promise;
+    assert.strictEqual(json.status, 200);
+    assert.strictEqual(json.json.choices[0].message.content, 'A pixel.');
+    assert.strictEqual(json.json.applied.image_inputs_attached, 1);
+    const sse = await call(port, validBody({ stream: true })).promise;
+    assert.strictEqual(sse.status, 200);
+    assert(sse.headers['content-type'].startsWith('text/event-stream'));
+    assert(sse.raw.includes('A pixel.'));
+    assert(sse.raw.includes('"image_inputs_attached":1'));
+    assert(sse.raw.endsWith('data: [DONE]\n\n'));
+  }); } finally { parser.normalizeChatMessages = originalNormalize; }
+  assert.strictEqual(calls, 2);
+  assert.strictEqual(pendingNames.length, 0);
+  assert.strictEqual(new Set(generatedNames).size, 2, 'JSON and SSE requests must receive independent names');
