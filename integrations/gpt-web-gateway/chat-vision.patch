+  for (const scenario of [{ chips: 0 }, { chips: 2 }, { wrongName: true }, { loaded: false },
+    { busy: true }, { uploadError: true }, { sendDisabled: true }, { unknown: true }, { hidden: true }]) {
+    assert.equal(ready(domState(scenario)), false, JSON.stringify(scenario));
+  }
+});
+
