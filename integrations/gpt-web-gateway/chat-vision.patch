+add('disconnect before submission aborts the signal and submit hook', async () => {
+  let entered = false;
+  let options;
+  let release;
+  let submitted = false;
+  let aborted;
+  const observed = new Promise((resolve) => { aborted = resolve; });
+  const hold = new Promise((resolve) => { release = resolve; });
+  bridge.completeText = async (prompt, opts) => {
+    entered = true;
+    options = opts;
+    await hold;
+    try { await opts.beforeSubmit(); submitted = true; }
+    catch (err) { aborted(err); throw err; }
+    return { text: 'bad', applied: {} };
+  };
+  await withRouter(async (port) => {
+    const pending = call(port, validBody({ stream: true }));
+    const cancelled = pending.promise.catch(() => null);
+    await waitUntil(() => entered, 'browser invocation');
+    pending.req.destroy();
+    await cancelled;
+    await waitUntil(() => options.signal.aborted, 'AbortSignal');
+    release();
+    const error = await observed;
+    assert.strictEqual(error.name, 'AbortError');
+    assert.strictEqual(submitted, false);
+    await waitUntil(() => bridge.poolHooks.status().running === 0, 'cancelled submission released');
+    assert.strictEqual(require('../src/progress').progress.snapshot().consecutive_infra_failures, 0);
+  });
+});
