+        assert(result.raw.includes('"error_kind":"timeout"'));
+        assert(result.raw.includes('"should_retry":false'));
+      } else {
+        assert.strictEqual(result.status, 504);
+        assert.strictEqual(result.json.should_retry, false);
+      }
+    });
+  }
+});
