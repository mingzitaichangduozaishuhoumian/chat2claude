+  assert.equal(ready(domState({ removeLabel })), true);
+  assert.equal(ready(domState({ removeLabel: '移除“old-image.png”' })), false);
+  assert.equal(ready(domState({ removeLabel, loaded: false })), false);
+  assert.equal(ready(domState({ removeLabel: `移除${image.name}` })), false);
+});
