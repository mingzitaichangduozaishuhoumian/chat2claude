+  assert.equal(ready(domState({ names }), 2), true);
+  for (const scenario of [
+    { actualNames: [names[0]] }, { actualNames: [names[0], names[0]] },
+    { actualNames: [names[0], 'old-image.png'] }, { actualNames: [...names, 'extra.png'] },
+    { previewOwners: [[0, 1], []] }, { previewOwners: [[0], [0]] },
+    { unloaded: [1] }, { sendDisabled: true }, { busy: true },
+  ]) assert.equal(ready(domState({ names, ...scenario }), 2), false, JSON.stringify(scenario));
+  assert.equal(ready(domState({ names }), 1), false);
+});
