+    && /^chatgpt(?:\s|$)/i.test(norm(classicPickers[0].innerText || classicPickers[0].textContent))
+    && !/\b(?:work|codex)\b/i.test(norm(classicPickers[0].innerText || classicPickers[0].textContent));
