+    get sendAttempted() { return sendAttempted; },
+    assertNotAborted: () => throwIfAborted(signal),
+    waitEmpty: page => wait(page, state => state?.known === true
+      && state.count === 0 && state.busy === false && state.uploadError === false,
+    emptyTimeoutMs, 1),
+    // A chip is only a preview. A loaded thumbnail, no upload activity/error and
+    // an enabled send button must agree across consecutive browser observations.
+    waitReady: page => wait(page, ready, timeoutMs, 2),
+    async beforeSend(page) {
+      // Read-only: never toggle a surface after an image has been uploaded.
+      await assertOrdinaryChat(page, signal);
+      if (!ready(await read(page))) throw attachmentError();
+    },
+    markSendAttempted() {
+      throwIfAborted(signal);
+      sendAttempted = true;
+    },
+  };
+}
+
