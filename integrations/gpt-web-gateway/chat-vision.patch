+}
+
+async function readChatSurface(page, signal) {
+  throwIfAborted(signal);
+  let timer;
+  let state;
+  try {
+    state = await Promise.race([
+      page.evaluate(chatSurfaceInPage, {
+        composerSelector: COMPOSER_SELECTORS.join(', '), tierSelector: TIER_TRIGGER_SEL,
+      }),
+      new Promise(resolve => { timer = setTimeout(() => resolve({ mode: 'unknown' }), 3000); }),
+    ]);
+  } catch {
+    state = { mode: 'unknown' };
+  } finally {
+    clearTimeout(timer);
+  }
+  throwIfAborted(signal);
+  return state || { mode: 'unknown' };
+}
+
+async function assertOrdinaryChat(page, signal) {
+  if ((await readChatSurface(page, signal)).mode !== 'chat') throw chatModeError();
+}
