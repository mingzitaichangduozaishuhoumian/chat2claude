+add('disconnect while queued does not call the browser or leak the pool slot', async () => {
+  let calls = 0;
+  let release;
+  const hold = new Promise((resolve) => { release = resolve; });
+  bridge.completeText = async (prompt, options) => {
+    calls += 1;
+    await hold;
+    await options.beforeSubmit();
+    return { text: 'done', applied: { thinking: false } };
+  };
+  await withRouter(async (port) => {
+    const first = call(port, { input: 'hold' });
+    await waitUntil(() => calls === 1, 'first browser call');
+    const queued = call(port, validBody());
+    const cancelled = queued.promise.catch(() => null);
+    await waitUntil(() => bridge.poolHooks.status().waiting === 1, 'queued image request');
+    queued.req.destroy();
+    await cancelled;
+    await new Promise((resolve) => setTimeout(resolve, 30));
+    release();
+    assert.strictEqual((await first.promise).status, 200);
+    await waitUntil(() => bridge.poolHooks.status().running === 0 && bridge.poolHooks.status().waiting === 0, 'cancelled job released');
+    assert.strictEqual(calls, 1, 'cancelled queued request must not reach completeText');
