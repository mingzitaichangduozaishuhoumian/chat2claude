+test('a preview is not upload completion: ready waits for two consistent complete states', async () => {
+  let now = 0;
+  const states = [{ ...readyState(), busy: true }, { ...readyState(), sendReady: false }, readyState(), readyState()];
+  let reads = 0;
+  const guard = createChatAttachmentGuard(image, undefined, {
+    now: () => now, pollMs: 10, timeoutMs: 100,
+    readState: async () => { reads++; return states.shift(); },
+  });
+  await guard.waitReady({ waitForTimeout: async ms => { now += ms; } });
+  assert.equal(reads, 4);
+});
