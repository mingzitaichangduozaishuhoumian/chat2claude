+    { chatActive: false, workActive: false }, { switcher: false, classicPicker: false },
+    { switcher: false, classicPicker: true, pickerText: 'ChatGPT Work' },
+    { pillText: '5.6 Sol Very high' }, { codexActive: true },
+    { composerKnown: false }, { url: 'https://chatgpt.com/work' },
+    { url: 'https://chatgpt.com/codex' }, { url: 'https://example.invalid/' },
+  ]) assert.notEqual(surfaceDomState(scenario).mode, 'chat', JSON.stringify(scenario));
