+    assert.equal((await chat.completeText('First turn with both images.', { thinkingMode: 'instant', images })).text, 'answer');
+    assert.equal(first.sends, 1);
+    assert.equal(first.closed, false);
+    const followup = 'First user turn and assistant reply.\nCompleted tool call and result.\nContinue using both images.';
+    assert.equal((await chat.completeText(followup, { thinkingMode: 'instant', images, noResend: true })).text, 'answer');
+    assert.equal(pages.length, 2);
+    assert.equal(first.closed, true);
+    assert.equal(second.closed, false);
+    assert.equal(peer.closed, false);
+    assert.equal(chat.getSlot(1).page, peer);
+    assert.equal(first.sends, 1);
+    assert.equal(second.sends, 1);
+    assert.equal(first.uploads.length, 1);
+    assert.equal(second.uploads.length, 1);
+    assert.deepEqual(second.sentPrompts, [followup]);
+    assert.deepEqual(second.uploads[0], images.map(value => ({ name: value.name, mimeType: value.mimeType, buffer: value.buffer })));
+  });
+});
+
+for (const continuation of [{ reuseChat: true }, { conversationId: '11111111-2222-4333-8444-555555555555' }]) {
+  test(`explicit image continuation preserves its existing page: ${Object.keys(continuation)[0]}`, async () => {
+    await fixture({}, async ({ chat, page, queue, pages }) => {
+      const first = visionPage(page); const unused = visionPage(page); queue.push(first, unused);
+      await chat.completeText('First turn.', { thinkingMode: 'instant', image });
+      await chat.completeText('Explicit continuation.', { thinkingMode: 'instant', image, ...continuation });
+      assert.equal(pages.length, 1);
+      assert.equal(first.closed, false);
+      assert.equal(first.sends, 2);
+      assert.equal(first.uploads.length, 2);
+      assert.deepEqual(first.sentPrompts, ['First turn.', 'Explicit continuation.']);
+    });
+  });
+}
diff --git a/scripts/test-chat-shutdown.js b/scripts/test-chat-shutdown.js
new file mode 100644
index 0000000..9102c09
--- /dev/null
+++ b/scripts/test-chat-shutdown.js
@@ -0,0 +1,145 @@
+// Real Node/HTTP/IPC shutdown tests. The owned browser is another local Node
+// process; no browser installation, network account, or ChatGPT session is used.
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const net = require('node:net');
+const { spawn } = require('node:child_process');
+const test = require('node:test');
+
+const root = path.resolve(__dirname, '..');
+const pause = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+async function freePort() {
+  const server = net.createServer();
+  await new Promise((resolve, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', resolve); });
+  const port = server.address().port;
+  await new Promise((resolve) => server.close(resolve));
+  return port;
+}
+
+function alive(pid) {
+  try { process.kill(pid, 0); return true; } catch (error) { if (error.code === 'ESRCH') return false; throw error; }
+}
+
+async function waitFor(predicate, description) {
+  const deadline = Date.now() + 8000;
+  while (!await predicate()) {
+    assert(Date.now() < deadline, description);
+    await pause(20);
+  }
+}
+
+function bootstrapSource(eventsPath) {
+  return `
+    const fs = require('node:fs');
+    const path = require('node:path');
+    const Module = require('node:module');
+    const { spawn } = require('node:child_process');
+    const root = ${JSON.stringify(root)};
+    const eventsPath = ${JSON.stringify(eventsPath)};
+    const record = (event) => fs.appendFileSync(eventsPath, JSON.stringify(event) + '\\n');
+    let owned;
+    let ownedExit;
+    const context = {
+      newPage: async () => ({ evaluate: async () => 'Chrome/150.0.0.0', close: async () => {} }),
+      close: async () => {},
+    };
+    const chromium = { launch: async () => {
+      record({ phase: 'launch-pending' });
+      process.send?.({ phase: 'launch-pending' });
+      await new Promise((resolve) => setTimeout(resolve, 750));
+      owned = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore', windowsHide: true });
+      ownedExit = new Promise((resolve) => owned.once('exit', resolve));
+      record({ phase: 'browser-open', pid: owned.pid });
+      return {
+        newContext: async () => context,
+        version: () => '150.0.0.0',
+        close: async () => {
+          if (owned.exitCode === null) owned.kill();
+          await ownedExit;
+          record({ phase: 'browser-closed' });
+        },
+      };
+    }};
+    const browser = () => require(path.join(root, 'src/browser.js'));
+    const chat = {
+      ensureSessionReady: () => browser().getContext().then(async () => {
+        record({ phase: 'context-ready' });
+        try { await browser().getContext(); record({ phase: 'unexpected-restart' }); }
+        catch { record({ phase: 'restart-blocked' }); }
+      }),
+      startSessionWatchdog: () => record({ phase: 'watchdog-started' }),
+      stopSessionWatchdog: () => record({ phase: 'watchdog-stopped' }),
+    };
+    const originalLoad = Module._load;
+    Module._load = function(request, parent, isMain) {
+      if (request === 'patchright') return { chromium };
+      if (request === 'dotenv') return { config() {} };
+      const resolved = Module._resolveFilename(request, parent);
+      if (resolved === path.join(root, 'src/chatgpt.js')) return chat;
+      if ([path.join(root, 'src/routes/images.js'), path.join(root, 'src/routes/login.js')].includes(resolved)) return require(path.join(root, 'node_modules/express')).Router();
+      if (resolved === path.join(root, 'src/metrics.js')) return { metricsHandler: (_req, res) => res.end('') };
+      if (resolved === path.join(root, 'src/progress.js')) return { progress: { liveness: () => ({ alive: true }), snapshot: () => ({}) } };
+      return originalLoad.call(this, request, parent, isMain);
+    };
+    require(path.join(root, 'src/server.js'));
+  `;
+}
+
+for (const cancellation of ['message', 'disconnect']) {
+  test(`${cancellation}: startup cancellation closes HTTP and the browser that launches later`, { timeout: 15000 }, async (t) => {
+    const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'gpt-gateway-shutdown-test-'));
+    const eventsPath = path.join(directory, 'events.jsonl');
+    const bootstrapPath = path.join(directory, 'bootstrap.cjs');
+    fs.writeFileSync(bootstrapPath, bootstrapSource(eventsPath));
+    const port = await freePort();
+    const child = spawn(process.execPath, [bootstrapPath], {
+      cwd: root,
+      stdio: ['ignore', 'pipe', 'pipe', 'ipc'],
+      windowsHide: true,
+      env: { ...process.env, HOST: '127.0.0.1', PORT: String(port), API_KEY: 'offline-test-key', HEADLESS: 'false', BROWSER_ENGINE: 'patchright', BROWSER_MODE: 'default', CHROMIUM_CHANNEL: 'chrome', PROXY_SERVER: '', BROWSER_USER_AGENT: '' },
+    });
+    child.stdout.resume();
+    child.stderr.resume();
+    const exited = new Promise((resolve, reject) => {
+      child.once('error', reject);
+      child.once('exit', (code, signal) => resolve({ code, signal }));
+    });
+    const events = () => fs.existsSync(eventsPath) ? fs.readFileSync(eventsPath, 'utf8').trim().split('\n').filter(Boolean).map((line) => JSON.parse(line)) : [];
+    t.after(async () => {
+      if (child.exitCode === null && child.signalCode === null) {
+        if (child.connected) child.send({ type: 'chat2claude:shutdown' }, () => {});
+        await Promise.race([exited, pause(2000)]);
+        if (child.exitCode === null && child.signalCode === null) child.kill();
+      }
+      // Cleanup only the explicitly created fake browser process, even after a regression.
+      for (const event of events().filter((event) => event.phase === 'browser-open')) if (alive(event.pid)) process.kill(event.pid);
+      const real = fs.realpathSync(directory);
+      assert.equal(path.dirname(real).toLowerCase(), fs.realpathSync(os.tmpdir()).toLowerCase());
+      assert(path.basename(real).startsWith('gpt-gateway-shutdown-test-'));
+      fs.rmSync(real, { recursive: true, force: true });
+    });
+    await waitFor(() => events().some((event) => event.phase === 'launch-pending'), 'server should begin its fake browser launch');
+    const health = await fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(2000) });
+    assert.equal(health.status, 200);
+    await health.body.cancel();
+    assert(!events().some((event) => event.phase === 'browser-open'), 'cancel while launch is pending');
+    if (cancellation === 'message') child.send({ type: 'chat2claude:shutdown' });
+    else child.disconnect();
+    await waitFor(async () => {
+      try { const response = await fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(200) }); await response.body.cancel(); return false; }
+      catch { return true; }
+    }, 'HTTP must stop accepting requests while browser startup is settling');
+    const outcome = await exited;
+    assert.deepEqual(outcome, { code: 0, signal: null });
+    const result = events();
+    assert(result.some((event) => event.phase === 'watchdog-stopped'));
+    assert(!result.some((event) => event.phase === 'watchdog-started'), 'startup finally must not restart watchdog');
+    assert(result.some((event) => event.phase === 'browser-open'), 'a browser completing launch after cancel must be accounted for');
+    assert(result.some((event) => event.phase === 'browser-closed'), 'the late browser must close before server exit');
+    assert(result.some((event) => event.phase === 'restart-blocked'), 'shutdown must prevent context recreation');
+    for (const event of result.filter((event) => event.phase === 'browser-open')) assert.equal(alive(event.pid), false, 'the fake browser process must not be orphaned');
+  });
+}
diff --git a/scripts/test-chat-tools.js b/scripts/test-chat-tools.js
new file mode 100644
index 0000000..9f421bf
--- /dev/null
+++ b/scripts/test-chat-tools.js
@@ -0,0 +1,428 @@
+'use strict';
+
+// Only pure parsers and an actual local HTTP router with a stubbed browser.
+// No ChatGPT requests, local tools, shell execution, or browser launches.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const Module = require('node:module');
+const express = require('express');
+const { normalizeChatMessages } = require('../src/lib/chat-vision.cjs');
+const { PROTOCOL, strictJson, prepareChatTools, parseToolReply, rejectsResponsesTools } = require('../src/lib/chat-tools.cjs');
+
+const ARGS = ' { "n": 9007199254740993123456789, "fraction": 0.1234567890123456789 } ';
+const tools = [{ type: 'function', function: { name: 'lookup', description: 'Read a value through the client.', parameters: { type: 'object', properties: { n: { type: 'integer' } } } } }];
+const requestBody = (extra = {}) => ({ messages: [{ role: 'user', content: 'Look up the requested value.' }], tools, ...extra });
+const prepare = (body) => prepareChatTools(body, normalizeChatMessages(body.messages, body.input));
+const envelope = (context, value) => JSON.stringify({ protocol: PROTOCOL, nonce: context.nonce, ...value });
+const callReply = (context, calls = [{ name: 'lookup', arguments: ARGS }]) => envelope(context, { type: 'tool_calls', tool_calls: calls });
+const objectCallReply = (context, argumentSource) => `{"protocol":${JSON.stringify(PROTOCOL)},"nonce":${JSON.stringify(context.nonce)},"type":"tool_calls","tool_calls":[{"name":"lookup","arguments":${argumentSource}}]}`;
+const finalReply = (context, content = 'The value was found.') => envelope(context, { type: 'final', content });
+const rejected = (fn) => assert.throws(fn, (error) => error.code === 'invalid_request');
+const badReply = (fn) => assert.throws(fn, (error) => error.code === 'invalid_tool_output' && error.noRetry === true
+  && ['json', 'fence', 'nonce', 'shape', 'tool', 'arguments'].includes(error.reason)
+  && Number.isSafeInteger(error.inputChars) && error.inputChars >= 0 && !error.message.includes(ARGS));
+const call = (id = 'call_old', name = 'lookup', args = ARGS) => ({ id, type: 'function', function: { name, arguments: args } });
+
+test('strict JSON rejects duplicate keys, malformed syntax, non-JSON code and excessive nesting', () => {
+  for (const value of ['{"x":1,"x":2}', '{"x":1,"\\u0078":2}', '{"x":undefined}', '{"x":NaN}', '{"x":Infinity}', '{"x":01}', '{"x":1,}', '{"x":1};process.exit()', '/*comment*/{}', '```json\n{}\n```', '{"x":"\\q"}', '{"x":"unterminated}', '['.repeat(66) + '0' + ']'.repeat(66)]) {
+    assert.throws(() => strictJson(value));
+  }
+  assert.equal(strictJson('{"nested":[true,false,null,{"text":"a\\nb"}]}').nested[3].text, 'a\nb');
+});
+
+test('protocol produces real tool calls with fresh IDs and original argument strings', () => {
+  const context = prepare(requestBody());
+  const first = parseToolReply(callReply(context), context);
+  const second = parseToolReply(callReply(context), context);
+  assert.equal(first.finishReason, 'tool_calls');
+  assert.equal(first.message.content, null);
+  assert.equal(first.message.tool_calls[0].function.arguments, ARGS);
+  assert.match(first.message.tool_calls[0].id, /^call_c2c_[a-f0-9-]{36}$/);
+  assert.notEqual(first.message.tool_calls[0].id, second.message.tool_calls[0].id);
+  assert.match(context.prompt, /Never execute tools/);
+  assert(!context.prompt.includes('eval('));
+});
+
+test('direct argument objects retain source numeric literals while legacy strings stay compatible', () => {
+  const context = prepare(requestBody());
+  const argumentSource = '{\n "big":9007199254740993, "precise":1.0000000000000001, "negativeZero":-0, "exponent":1e+0001, "text":"brace } and {", "nested":{"tool_calls":[{"arguments":{"notCaptured":1}}]}\n}';
+  const raw = objectCallReply(context, argumentSource);
+  const ranges = new Map();
+  strictJson(raw, undefined, ranges);
+  assert.equal(ranges.size, 1, 'only the root tool_calls[index].arguments object is captured');
+  assert.equal(raw.slice(ranges.get(0).start, ranges.get(0).end), argumentSource);
+  const result = parseToolReply(raw, context);
+  assert.equal(result.message.tool_calls[0].function.arguments, argumentSource);
+  assert(result.message.tool_calls[0].function.arguments.includes('9007199254740993'));
+  assert(result.message.tool_calls[0].function.arguments.includes('1.0000000000000001'));
+  assert.equal(parseToolReply(`\`\`\`json\n${raw}\n\`\`\``, context).message.tool_calls[0].function.arguments, argumentSource);
+  assert.equal(parseToolReply(callReply(context), context).message.tool_calls[0].function.arguments, ARGS);
+  for (const invalid of ['{"x":1,"x":2}', '{"x":1,"\\u0078":2}', '{"x":undefined}', '[]', 'null', '42']) {
+    badReply(() => parseToolReply(objectCallReply(context, invalid), context));
+  }
+  assert(context.prompt.includes('"arguments":{}'));
+  assert(context.prompt.includes('arguments must be a JSON object'));
+});
+
+test('auto, none, required and named choices enforce their actual output constraints', () => {
+  const auto = prepare(requestBody());
+  assert.equal(parseToolReply(finalReply(auto), auto).finishReason, 'stop');
+  const none = prepare(requestBody({ tool_choice: 'none' }));
+  assert.equal(parseToolReply(finalReply(none), none).message.content, 'The value was found.');
+  badReply(() => parseToolReply(callReply(none), none));
+  const required = prepare(requestBody({ tool_choice: 'required' }));
+  assert.equal(parseToolReply(callReply(required), required).finishReason, 'tool_calls');
+  badReply(() => parseToolReply(finalReply(required), required));
+  const named = prepare(requestBody({ tool_choice: { type: 'function', function: { name: 'lookup' } } }));
+  assert.equal(parseToolReply(callReply(named), named).finishReason, 'tool_calls');
+  badReply(() => parseToolReply(finalReply(named), named));
+  badReply(() => parseToolReply(callReply(named, [{ name: 'unknown', arguments: '{}' }]), named));
+  rejected(() => prepare(requestBody({ tool_choice: { type: 'function', function: { name: 'unknown' } } })));
+  rejected(() => prepare(requestBody({ tools: [], tool_choice: 'required' })));
+});
+
+test('parallel false accepts one call; true accepts a bounded batch without executing it', () => {
+  const serial = prepare(requestBody({ parallel_tool_calls: false }));
+  assert.equal(parseToolReply(callReply(serial), serial).message.tool_calls.length, 1);
+  badReply(() => parseToolReply(callReply(serial, Array(2).fill({ name: 'lookup', arguments: '{}' })), serial));
+  const parallel = prepare(requestBody({ parallel_tool_calls: true }));
+  assert.equal(parseToolReply(callReply(parallel, Array(8).fill({ name: 'lookup', arguments: '{}' })), parallel).message.tool_calls.length, 8);
+  badReply(() => parseToolReply(callReply(parallel, Array(9).fill({ name: 'lookup', arguments: '{}' })), parallel));
+  rejected(() => prepare(requestBody({ parallel_tool_calls: 'false' })));
+});
+
+test('complete public tool history preserves original call IDs, names, argument strings and results', () => {
+  const context = prepare(requestBody({ messages: [
+    { role: 'user', content: 'Read two values.' },
+    { role: 'assistant', content: null, tool_calls: [call('call_A'), call('call_B', 'previous_tool', '{"raw":9007199254740993}')] },
+    { role: 'tool', tool_call_id: 'call_B', content: 'second result' },
+    { role: 'tool', name: 'lookup', tool_call_id: 'call_A', content: [{ type: 'text', text: '  first result\n' }] },
+  ] }));
+  const control = JSON.parse(context.prompt.split('\n').at(-1));
+  assert.deepEqual(control.messages[1].tool_calls, [call('call_A'), call('call_B', 'previous_tool', '{"raw":9007199254740993}')]);
+  assert.equal(control.messages[2].tool_call_id, 'call_B');
+  assert.equal(control.messages[2].name, 'previous_tool');
+  assert.equal(control.messages[3].content, '  first result\n');
+  const largerCalls = Array.from({ length: 128 }, (_, index) => call(`call_${index}`));
+  const larger = prepare(requestBody({ messages: [
+    { role: 'assistant', content: null, tool_calls: largerCalls },
+    ...largerCalls.map(item => ({ role: 'tool', tool_call_id: item.id, content: 'completed' })),
+  ] }));
+  assert.equal(JSON.parse(larger.prompt.split('\n').at(-1)).messages[0].tool_calls.length, 128, 'completed Codex history can exceed the new-output batch limit');
+});
+
+test('missing, duplicate, unknown, interrupted and malformed tool histories reject before dispatch', () => {
+  const assistant = { role: 'assistant', content: null, tool_calls: [call()] };
+  for (const history of [
+    [assistant],
+    [assistant, { role: 'user', content: 'continue without the result' }],
+    [{ role: 'tool', tool_call_id: 'unknown', content: 'result' }],
+    [assistant, { role: 'tool', tool_call_id: 'call_old', content: 'one' }, { role: 'tool', tool_call_id: 'call_old', content: 'duplicate' }],
+    [assistant, { role: 'tool', tool_call_id: 'call_old', name: 'different', content: 'result' }],
+    [assistant, { role: 'tool', tool_call_id: 'call_old', content: null }],
+    [{ role: 'assistant', content: null, tool_calls: [call(), call()] }],
+    [{ role: 'assistant', content: null, tool_calls: Array.from({ length: 129 }, (_, index) => call(`call_${index}`)) }],
+    [{ role: 'assistant', content: null, tool_calls: [call('x', 'lookup', '{"x":1,"x":2}')] }],
+    [{ role: 'assistant', content: null, tool_calls: [call('x', 123, '{}')] }],
+    [{ role: 'user', content: 'x', tool_calls: [call()] }],
+    [{ role: 'assistant', content: 'x', function_call: { name: 'lookup', arguments: '{}' } }],
+  ]) rejected(() => prepare(requestBody({ messages: history })));
+});
+
+test('unsupported definitions, strict schemas and ambiguous request semantics reject', () => {
+  for (const extra of [
+    { tools: null }, { tools: [{ type: 'web_search' }] }, { tools: [...tools, ...tools] },
+    { tools: [{ type: 'function', function: { name: 'x', strict: true } }] },
+    { tools: [{ type: 'function', function: { name: 123 } }] },
+    { tools: [{ type: 'function', function: { name: 'x', parameters: { type: 'array' } } }] },
+    { tool_choice: 'sometimes' }, { n: 2 }, { response_format: { type: 'json_object' } },
+    { functions: [] }, { function_call: 'auto' }, { input: 'also an input' },
+  ]) rejected(() => prepare(requestBody(extra)));
+  assert(prepare(requestBody({ tools: [{ type: 'function', function: { name: 'x', strict: false } }] })));
+  assert.equal(prepare({ messages: [{ role: 'user', content: 'plain text' }] }), null);
+  rejected(() => rejectsResponsesTools({ tools }));
+  rejected(() => rejectsResponsesTools({ input: [{ type: 'function_call_output', call_id: 'x', output: 'y' }] }));
+});
+
+test('invalid protocol output never becomes an empty success or a partially executable call', () => {
+  const context = prepare(requestBody());
+  for (const output of [
+    '', 'Just an ordinary answer.',
+    envelope(context, { type: 'final', content: '' }), envelope(context, { type: 'final', content: 'ok', unexpected: true }),
+    JSON.stringify({ protocol: PROTOCOL, nonce: 'wrong', type: 'final', content: 'ok' }),
+    callReply(context, []), callReply(context, [{ name: 'undeclared', arguments: '{}' }]),
+    ...['[]', 'null', '42', '{"x":1,"x":2}', '{"x":undefined}', 'process.exit()'].map(args => callReply(context, [{ name: 'lookup', arguments: args }])),
+    envelope(context, { type: 'tool_calls', tool_calls: [{ name: 'lookup', arguments: '{}', id: 'model_chosen' }] }),
+  ]) badReply(() => parseToolReply(output, context));
+});
+
+test('only one complete JSON or unlabelled fence may wrap the strict protocol', () => {
+  const context = prepare(requestBody());
+  for (const label of ['json', 'JSON', '']) {
+    const final = ` \n\`\`\`${label}\r\n${finalReply(context)}\r\n\`\`\`\n `;
+    assert.equal(parseToolReply(final, context).message.content, 'The value was found.');
+    const calls = `\`\`\`${label}\n${callReply(context)}\n\`\`\``;
+    assert.equal(parseToolReply(calls, context).message.tool_calls[0].function.arguments, ARGS);
+  }
+  // Literal Markdown inside a JSON string is answer content, not another block.
+  const codeAnswer = finalReply(context, 'Example: ```js\\n1 + 1\\n```');
+  assert.equal(parseToolReply(`\`\`\`json\n${codeAnswer}\n\`\`\``, context).finishReason, 'stop');
+  for (const invalid of [
+    `Preamble\n\`\`\`json\n${finalReply(context)}\n\`\`\``,
+    `\`\`\`json\n${finalReply(context)}\n\`\`\`\nTrailing explanation`,
+    `\`\`\`json\n${finalReply(context)}\n\`\`\`\n\`\`\`json\n${finalReply(context)}\n\`\`\``,
+    `\`\`\`javascript\n${finalReply(context)}\n\`\`\``,
+    `\`\`\`json\n${finalReply(context)}`,
+    `\`\`\`json\n${envelope(context, { type: 'tool_calls', tool_calls: [{ name: 'undeclared', arguments: '{}' }] })}\n\`\`\``,
+    `\`\`\`json\n${callReply(context, [{ name: 'lookup', arguments: '{"x":1,"x":2}' }])}\n\`\`\``,
+  ]) badReply(() => parseToolReply(invalid, context));
+});
+
+test('the exact whole-answer escape wrapper preserves strict JSON, values and tool checks', () => {
+  const context = prepare(requestBody());
+  const argumentsText = '{"big":9007199254740993,"precise":1.0000000000000001,"code":"console.log(73)","literal":"<escape>data</escape>"}';
+  const calls = objectCallReply(context, argumentsText);
+  assert.equal(parseToolReply(` \n<escape>${calls}</escape>\n `, context).message.tool_calls[0].function.arguments, argumentsText);
+  assert.equal(parseToolReply(`<escape>${finalReply(context)}</escape>`, context).message.content, 'The value was found.');
+  for (const invalid of [
+    `Before <escape>${calls}</escape>`, `<escape>${calls}</escape> After`,
