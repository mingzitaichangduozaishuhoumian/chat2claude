+function visionPage(page, scenario = {}) {
+  const p = page({ answer: scenario.answer !== false });
+  const evaluate = p.evaluate.bind(p);
+  const locator = p.locator.bind(p);
+  const send = p.send.bind(p);
+  p.attachments = 0;
+  p.uploads = [];
+  p.keys = [];
+  p.guardReads = 0;
+  p.surfaceChecks = 0;
+  p.chatClicks = 0;
+  p.chatClickNames = [];
+  p.surface = scenario.surface || { mode: 'chat', switcher: false };
+  p.evaluate = async (fn, arg) => {
+    const source = String(fn);
+    if (fn.name === 'chatSurfaceInPage') {
+      p.surfaceChecks++;
+      await scenario.onSurface?.(p);
+      if (scenario.surfaceReadFails) throw new Error('private surface DOM failure');
+      return p.surface;
+    }
+    if (fn.name === 'attachmentStateInPage') {
+      p.guardReads++;
+      await scenario.onGuard?.(p);
+      const uploaded = p.uploads.at(-1) || [];
+      const matching = uploaded.filter(file => file.name === arg?.name).length;
+      return { ...readyState(), count: p.attachments, matching: p.attachments > 0 ? matching : 0,
+        ...(p.attachments > 0 ? scenario.state : {}), ...(p.guardState || {}) };
+    }
+    if (arg === ATTACHMENT_REMOVE_SEL) {
+      if (source.includes('btn.click()')) { p.attachments = scenario.staleAttachment ? 1 : 0; return; }
+      return p.attachments;
+    }
+    const result = await evaluate(fn, arg);
+    if (source.includes('captionSrc') && arg?.matchers) await scenario.onTierRead?.(p);
+    return result;
+  };
+  p.getByRole = (role, options) => {
+    const button = { first: () => button, click: async () => {
+      p.chatClicks++;
+      p.chatClickNames.push({ role, name: options.name });
+      if (scenario.switchFails) throw new Error('private click failure');
+      if (scenario.switchToChat) p.surface = { mode: 'chat', switcher: true, chatRole: 'button' };
+    } };
+    return button;
+  };
+  p.locator = selector => {
+    if (/input\[type="file"\]|upload-photos/.test(selector)) {
+      const file = { first: () => file, waitFor: async () => {}, evaluate: async () => {},
+        setInputFiles: async files => {
+          p.uploads.push(files);
+          p.attachments = scenario.uploadCount ?? files.length;
+          await scenario.onUpload?.(p);
+        } };
+      return file;
+    }
+    const control = locator(selector);
+    if (selector === SEND_BUTTON_SEL && scenario.sendButtonMissing) {
+      control.waitFor = async () => {
+        await scenario.onMissingSend?.(p);
+        throw new Error('The send button is unavailable.');
+      };
+    }
+    if (/prompt-textarea|contenteditable|textarea/.test(selector)) {
+      const fill = control.fill;
+      control.fill = async text => { await fill(text); await scenario.onFill?.(p); };
+    }
+    return control;
+  };
+  p.keyboard = {
+    press: async key => {
+      p.keys.push(key);
+      if (key === 'Backspace') p.composer = '';
+      if (key === 'Shift+Enter') p.composer += '\n';
+      if (key === 'Enter') await p.send();
+    },
+    type: async text => { p.composer += text; await scenario.onType?.(p); },
+  };
+  p.send = async () => {
+    await scenario.beforeClick?.(p);
+    if (p.closed) throw new Error('Page was closed while waiting to click.');
+    await send();
+    if (scenario.clickFailure) throw new Error('Execution context was destroyed: private cookie base64');
+  };
+  return p;
+}
