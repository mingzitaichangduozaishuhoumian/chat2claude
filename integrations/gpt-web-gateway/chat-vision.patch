+'use strict';
+
+const { randomUUID } = require('node:crypto');
+
+// Keep the first vision contract intentionally narrow: one attached image on the
+// latest user message. Never turn an unsupported image into a text-only request.
+const MAX_CHAT_REQUEST_BYTES = 16 * 1024 * 1024;
+const MAX_CHAT_IMAGE_BYTES = 10 * 1024 * 1024;
+const IMAGE_ONLY_PROMPT = 'Describe the attached image.';
+const EXTENSIONS = { 'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp', 'image/gif': 'gif' };
+
+function invalid(message) {
+  const err = new Error(message);
+  err.code = 'invalid_request';
+  return err;
+}
+
+function matchesMime(buffer, mimeType) {
+  if (mimeType === 'image/png') return buffer.length >= 8 && buffer.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]));
+  if (mimeType === 'image/jpeg') return buffer.length >= 3 && buffer[0] === 255 && buffer[1] === 216 && buffer[2] === 255;
+  if (mimeType === 'image/webp') return buffer.length >= 12 && buffer.toString('ascii', 0, 4) === 'RIFF' && buffer.toString('ascii', 8, 12) === 'WEBP';
+  if (mimeType === 'image/gif') return buffer.length >= 6 && ['GIF87a', 'GIF89a'].includes(buffer.toString('ascii', 0, 6));
+  return false;
+}
+
+function parseImageUrl(value) {
+  const url = typeof value === 'string' ? value : value && value.url;
+  if (typeof url !== 'string') throw invalid('image_url must contain a base64 image data URL');
+  const match = /^data:(image\/(?:png|jpeg|webp|gif));base64,([A-Za-z0-9+/]*={0,2})$/.exec(url);
+  if (!match) throw invalid('Only base64 PNG, JPEG, WebP, or GIF image data URLs are supported');
+  const [, mimeType, encoded] = match;
+  if (!encoded || encoded.length > Math.ceil(MAX_CHAT_IMAGE_BYTES / 3) * 4) throw invalid('Image is empty or exceeds the 10 MiB image limit');
+  if (encoded.length % 4 !== 0) throw invalid('Image data must use canonical base64 encoding');
+  const buffer = Buffer.from(encoded, 'base64');
+  if (buffer.toString('base64') !== encoded) throw invalid('Image data must use canonical base64 encoding');
+  if (!buffer.length || buffer.length > MAX_CHAT_IMAGE_BYTES) throw invalid('Image is empty or exceeds the 10 MiB image limit');
+  if (!matchesMime(buffer, mimeType)) throw invalid('Image bytes do not match the declared image MIME type');
+  // ChatGPT can rename a reused filename with a numeric suffix. A unique ASCII
+  // name avoids that collision while retaining exact-name attachment checks.
+  return { name: `chat-vision-${randomUUID()}.${EXTENSIONS[mimeType]}`, mimeType, buffer };
+}
+
+function hasImage(value) {
