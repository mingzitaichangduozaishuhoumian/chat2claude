+}
+
+async function readChatSurface(page, signal) {
+  throwIfAborted(signal);
+  let timer;
+  let state;
+  try {
+    state = await Promise.race([
+      page.evaluate(chatSurfaceInPage, {
+        composerSelector: COMPOSER_SELECTORS.join(', '), tierSelector: TIER_TRIGGER_SEL,
+      }),
+      new Promise(resolve => { timer = setTimeout(() => resolve({ mode: 'unknown' }), 3000); }),
+    ]);
+  } catch {
+    state = { mode: 'unknown' };
+  } finally {
+    clearTimeout(timer);
+  }
+  throwIfAborted(signal);
+  return state || { mode: 'unknown' };
+}
+
+async function assertOrdinaryChat(page, signal) {
+  if ((await readChatSurface(page, signal)).mode !== 'chat') throw chatModeError();
+}
+
+// Runs in the browser. Return only state flags, never DOM text, URLs or image data.
+// Unknown composer markup is deliberately not a successful upload confirmation.
+function attachmentStateInPage({ name, composerSelector, sendSelector, removeSelector }) {
+  const visible = element => !!element && !element.closest('[aria-hidden="true"]')
+    && element.getClientRects().length > 0;
+  const editors = Array.from(document.querySelectorAll(composerSelector)).filter(visible);
+  if (editors.length !== 1) return { known: false };
+  const form = editors[0].closest('form');
+  if (!form || !visible(form)) return { known: false };
+  const chips = Array.from(form.querySelectorAll(removeSelector)).filter(visible);
+  const matching = chips.filter(button => {
+    const label = String(button.getAttribute('aria-label') || '').trim();
+    return label === `移除“${name}”`
+      || /^(?:Remove|Удалить)\s+/i.test(label)
+        && label.slice(label.indexOf(' ') + 1).trim() === name;
+  });
+  const regions = Array.from(form.querySelectorAll('[data-composer-attachments]')).filter(visible);
+  // Fall back only to a chip's own wrapper on the older composer. Do not count
+  // avatars or unrelated images elsewhere on the page as the uploaded image.
+  const previewRegion = regions.length === 1 ? regions[0]
+    : matching.length === 1 ? matching[0].parentElement : null;
+  const previews = previewRegion
+    ? Array.from(previewRegion.querySelectorAll('img')).filter(visible) : [];
+  const previewLoaded = previews.length === 1
+    && previews[0].complete === true && previews[0].naturalWidth > 0;
+  const busySelector = '[aria-busy="true"], [role="progressbar"], '
+    + '[data-state="uploading"], [data-upload-state="uploading"], '
+    + '[data-testid*="upload-progress"], [data-testid*="uploading"], '
+    + '.animate-spin, [class*="spinner"]';
+  const busy = Array.from(form.querySelectorAll(busySelector)).some(visible);
+  const errorSelector = '[data-state="error"], [data-upload-state="error"], '
+    + '[data-testid*="upload-error"], [role="alert"]';
+  const uploadError = Array.from(form.querySelectorAll(errorSelector)).some(visible)
+    || Array.from(document.querySelectorAll('[role="alert"], [data-testid*="toast"], [class*="toast"]'))
+      .filter(visible).some(element => /failed to upload|unable to upload|error uploading|upload failed|couldn.t upload|can.t upload|не удалось загрузить|ошибка загрузки/i
+        .test(element.innerText || element.textContent || ''));
+  const sends = Array.from(form.querySelectorAll(sendSelector)).filter(visible);
+  const sendReady = sends.length === 1 && sends[0].disabled !== true
+    && !sends[0].hasAttribute('disabled')
+    && sends[0].getAttribute('aria-disabled') !== 'true';
+  return { known: true, count: chips.length, matching: matching.length,
+    previewLoaded, busy, uploadError, sendReady };
+}
+
+function ready(state) {
+  return state?.known === true && state.count === 1 && state.matching === 1
+    && state.previewLoaded === true && state.busy === false
+    && state.uploadError === false && state.sendReady === true;
+}
+
+function createChatAttachmentGuard(image, signal, {
+  timeoutMs = 30000, emptyTimeoutMs = 5000, pollMs = 250,
+  readTimeoutMs = 3000, now = Date.now, readState,
+} = {}) {
+  // Match only the request-scoped UUIDv4 names emitted by chat-vision.cjs.
+  // No paths, arbitrary filenames, control characters or shared legacy names.
+  const name = image?.name;
+  if (typeof name !== 'string' || /[\x00-\x20\x7f]/.test(name)
+      || !/^chat-vision-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\.(?:png|jpe?g|webp|gif)$/.test(name)) {
+    throw attachmentError();
+  }
+  let sendAttempted = false;
+  const read = async page => {
+    throwIfAborted(signal);
+    let state;
+    let timer;
+    try {
+      const evaluation = readState ? readState(page) : page.evaluate(attachmentStateInPage, {
+        name: image.name, composerSelector: COMPOSER_SELECTORS.join(', '),
+        sendSelector: SEND_BUTTON_SEL, removeSelector: ATTACHMENT_REMOVE_SEL,
+      });
+      // This race contains a read-only DOM observation, never an action. A stuck
+      // renderer must not retain a pool slot indefinitely; a late read cannot send.
+      state = await Promise.race([evaluation, new Promise(resolve => {
+        timer = setTimeout(() => resolve({ known: false }), readTimeoutMs);
+      })]);
+    } catch {
+      throwIfAborted(signal);
+      return { known: false };
+    } finally {
+      clearTimeout(timer);
+    }
+    throwIfAborted(signal);
+    return state;
+  };
+  const wait = async (page, predicate, budget, stableRequired) => {
+    const deadline = now() + budget;
+    let consecutive = 0;
+    do {
+      const state = await read(page);
+      if (state?.uploadError === true) throw attachmentError();
+      consecutive = predicate(state) ? consecutive + 1 : 0;
+      if (consecutive >= stableRequired) return;
+      await page.waitForTimeout(Math.min(pollMs, Math.max(1, deadline - now())));
+      throwIfAborted(signal);
+    } while (now() < deadline);
+    throw attachmentError();
+  };
