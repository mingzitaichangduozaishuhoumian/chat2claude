+test('real message parser image names cross the completeText browser boundary unchanged', async () => {
+  const png = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aI1sAAAAASUVORK5CYII=', 'base64');
+  const input = normalizeChatMessages([{ role: 'user', content: [
