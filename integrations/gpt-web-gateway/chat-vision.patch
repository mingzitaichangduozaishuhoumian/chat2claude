+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+  createChatAttachmentGuard, attachmentStateInPage, ready, safeChatImageError, chatSurfaceInPage,
+} = require('../src/lib/chat-attachment.cjs');
+const { fixture } = require('./test-stall-diagnostics');
+const { normalizeChatMessages } = require('../src/lib/chat-vision.cjs');
+const { COMPOSER_SELECTORS, SEND_BUTTON_SEL, ATTACHMENT_REMOVE_SEL, TIER_TRIGGER_SEL } = require('../src/composer-dom');
+
+const image = { name: 'chat-vision-11111111-2222-4333-8444-555555555555.png', mimeType: 'image/png', buffer: Buffer.from('offline-image-fixture') };
+const readyState = () => ({ known: true, count: 1, matching: 1, previewLoaded: true,
+  busy: false, uploadError: false, sendReady: true });
+
+function domState({ chips = 1, wrongName = false, loaded = true, busy = false,
+  uploadError = false, sendDisabled = false, unknown = false, hidden = false, removeLabel } = {}) {
+  const node = (attrs = {}) => ({ parentElement: null, disabled: false,
+    getClientRects: () => hidden ? [] : [{}],
+    closest: selector => selector === 'form' ? form : null,
+    getAttribute: key => attrs[key] ?? null,
+    hasAttribute: key => Object.prototype.hasOwnProperty.call(attrs, key),
+  });
+  const preview = Object.assign(node({ alt: image.name }), { complete: loaded, naturalWidth: loaded ? 480 : 0 });
+  const region = Object.assign(node(), { querySelectorAll: selector => selector === 'img' ? [preview] : [] });
+  const buttons = Array.from({ length: chips }, () => Object.assign(node({
+    'aria-label': removeLabel ?? 'Remove ' + (wrongName ? 'old-image.png' : image.name),
+  }), { parentElement: region }));
+  const send = Object.assign(node(sendDisabled ? { disabled: '' } : {}), { disabled: sendDisabled });
+  const form = Object.assign(node(), { querySelectorAll: selector => {
+    if (selector === ATTACHMENT_REMOVE_SEL) return buttons;
+    if (selector === SEND_BUTTON_SEL) return [send];
+    if (selector === '[data-composer-attachments]') return [region];
+    if (selector.includes('[aria-busy=')) return busy ? [node()] : [];
+    if (selector.includes('[data-state="error"]')) return uploadError ? [node()] : [];
+    return [];
+  } });
+  const editor = node();
+  const oldDocument = global.document;
+  global.document = { querySelectorAll: selector => selector === COMPOSER_SELECTORS.join(', ')
+    ? unknown ? [] : [editor] : [] };
+  try {
+    return attachmentStateInPage({ name: image.name, composerSelector: COMPOSER_SELECTORS.join(', '),
+      sendSelector: SEND_BUTTON_SEL, removeSelector: ATTACHMENT_REMOVE_SEL });
+  } finally {
+    if (oldDocument === undefined) delete global.document; else global.document = oldDocument;
+  }
+}
+
+test('DOM guard requires one named, loaded attachment and an enabled send button', () => {
+  assert.equal(ready(domState()), true);
+  for (const scenario of [{ chips: 0 }, { chips: 2 }, { wrongName: true }, { loaded: false },
+    { busy: true }, { uploadError: true }, { sendDisabled: true }, { unknown: true }, { hidden: true }]) {
+    assert.equal(ready(domState(scenario)), false, JSON.stringify(scenario));
+  }
+});
+
+test('observed Chinese remove label confirms only the exact file with a loaded preview', () => {
+  const removeLabel = `移除“${image.name}”`;
+  assert.equal(ready(domState({ removeLabel })), true);
+  assert.equal(ready(domState({ removeLabel: '移除“old-image.png”' })), false);
+  assert.equal(ready(domState({ removeLabel, loaded: false })), false);
+  assert.equal(ready(domState({ removeLabel: `移除${image.name}` })), false);
+});
+
+function surfaceDomState({ switcher = true, chatActive = true, workActive = false,
+  classicPicker = false, pickerText = 'ChatGPT', pillText = 'Instant',
+  composerKnown = true, url = 'https://chatgpt.com/', codexActive = false,
+  chatLabel = 'Chat', workLabel = 'Work', activeAttribute = 'aria-selected', dataState } = {}) {
+  const element = (text, attrs = {}) => ({ innerText: text, textContent: text,
+    getClientRects: () => [{}], getAttribute: key => attrs[key] ?? null,
+    closest: selector => selector === 'form' ? {} : null,
+  });
+  const buttons = switcher ? [element(chatLabel, { [activeAttribute]: String(chatActive), ...(dataState ? { 'data-state': dataState } : {}) }),
+    element(workLabel, { [activeAttribute]: String(workActive), ...(dataState ? { 'data-state': dataState } : {}) })] : [];
+  if (codexActive) buttons.push(element('Codex', { 'aria-selected': 'true' }));
+  const oldDocument = global.document;
+  const oldLocation = global.location;
+  global.location = { href: url };
+  global.document = { querySelectorAll: selector => {
+    if (selector === 'button, [role="button"], [role="tab"]') return buttons;
+    if (selector === COMPOSER_SELECTORS.join(', ')) return composerKnown ? [element('')] : [];
+    if (selector === TIER_TRIGGER_SEL) return pillText ? [element(pillText)] : [];
+    if (selector === 'button[data-testid="model-switcher-dropdown-button"]') return classicPicker ? [element(pickerText)] : [];
+    return [];
+  } };
+  try { return chatSurfaceInPage({ composerSelector: COMPOSER_SELECTORS.join(', '), tierSelector: TIER_TRIGGER_SEL }); }
+  finally {
+    if (oldDocument === undefined) delete global.document; else global.document = oldDocument;
+    if (oldLocation === undefined) delete global.location; else global.location = oldLocation;
+  }
+}
