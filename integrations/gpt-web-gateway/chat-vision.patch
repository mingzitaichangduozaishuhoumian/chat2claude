+'use strict';
+
+const {
+  COMPOSER_SELECTORS, SEND_BUTTON_SEL, ATTACHMENT_REMOVE_SEL, TIER_TRIGGER_SEL,
+} = require('../composer-dom');
+
+function attachmentError() {
+  const error = new Error('Chat image attachment could not be confirmed ready; no message was sent.');
+  error.code = 'upload_failed';
+  return error;
+}
+
+function chatModeError() {
+  const error = new Error('Ordinary Chat could not be confirmed; the request was not sent.');
+  error.code = 'chat_mode_unconfirmed';
+  error.noRetry = true;
+  return error;
+}
+
+function throwIfAborted(signal) {
+  if (!signal?.aborted) return;
+  // AbortSignal.reason can contain caller data. Never put it in API errors/logs.
+  const error = new Error('Chat image request was cancelled.');
+  error.name = 'AbortError';
+  error.code = 'request_cancelled';
+  throw error;
+}
+
+function safeChatImageError(error) {
+  const messages = {
+    request_cancelled: 'Chat image request was cancelled.',
+    upload_failed: 'Chat image attachment could not be confirmed ready.',
+    rate_limit: 'Chat image request was rate limited.',
+    logged_out: 'Chat image request requires a logged-in browser session.',
+    page_load_failed: 'Chat image request could not complete on the browser page.',
+    conversation_not_found: 'Chat image request conversation is not accessible.',
+    timeout: 'Chat image request timed out.',
+    prompt_too_long: 'Chat image request text is too long for attachment-preserving input.',
+    chat_mode_unconfirmed: 'Ordinary Chat could not be confirmed; the request was not sent.',
+  };
+  const code = Object.prototype.hasOwnProperty.call(messages, error?.code)
+    ? error.code : 'page_load_failed';
+  const safe = new Error(messages[code]);
+  safe.code = code;
+  if (code === 'request_cancelled') safe.name = 'AbortError';
+  // Do not forward arbitrary browser errors, modelMessage, signal.reason or cause.
+  if (error?.retryAfterMaintenance === true) safe.retryAfterMaintenance = true;
+  if (error?.noRetry === true) safe.noRetry = true;
+  return safe;
+}
+
+// Positive surface evidence is required. A missing switcher/pill is not proof
+// that this is Chat, and the title "ChatGPT" alone also appears on Work pages.
+// Return flags only, so failures never expose page text or URLs.
+function chatSurfaceInPage({ composerSelector, tierSelector }) {
+  const visible = element => !!element && !element.closest('[aria-hidden="true"]')
+    && element.getClientRects().length > 0;
+  const norm = text => String(text || '').toLowerCase().replace(/\s+/g, ' ').trim();
+  const active = element => element.getAttribute('aria-selected') === 'true'
+    || element.getAttribute('aria-checked') === 'true'
+    || element.getAttribute('aria-pressed') === 'true'
+    || element.getAttribute('aria-current') != null
+    || ['active', 'checked', 'on'].includes(element.getAttribute('data-state') || '');
+  const url = new URL(location.href);
+  if (url.protocol !== 'https:' || url.hostname !== 'chatgpt.com'
+      || !/^\/(?:c\/[0-9a-f-]+\/?)?$/i.test(url.pathname)) {
+    return { mode: 'unknown', switcher: false };
+  }
+  const buttons = Array.from(document.querySelectorAll('button, [role="button"], [role="tab"]')).filter(visible);
+  const chats = buttons.filter(element => ['chat', '聊天'].includes(norm(element.innerText || element.textContent)));
+  const works = buttons.filter(element => ['work', '工作'].includes(norm(element.innerText || element.textContent)));
+  const workActive = works.some(active) || buttons.some(element =>
+    norm(element.innerText || element.textContent) === 'codex' && active(element));
+  const pills = Array.from(document.querySelectorAll(tierSelector)).filter(visible);
+  const workPill = pills.some(element => {
+    const text = norm(element.innerText || element.textContent)
+      .replace(/^(thinking effort|intelligence|интеллект|уровень рассуждений)\s*/i, '');
+    return /^(?:gpt-)?\d[\d.]*(?:\s+[a-z]+)?\s+/i.test(text) || /\b(?:work|codex)\b/i.test(text);
+  });
+  const editors = Array.from(document.querySelectorAll(composerSelector)).filter(visible);
+  const composerKnown = editors.length === 1 && !!editors[0].closest('form');
+  const switcher = chats.length === 1 && works.length === 1;
+  const chatActive = chats.length === 1 && active(chats[0]);
+  const chatRole = chats.length === 1 && chats[0].getAttribute('role') === 'tab' ? 'tab' : 'button';
+  // Only return a label from the observed fixed vocabulary, never page content.
+  const chatLabel = chats.length === 1 && norm(chats[0].innerText || chats[0].textContent) === '聊天' ? '聊天' : 'Chat';
+  if (workActive || workPill) return { mode: 'work', switcher, chatRole, chatLabel };
+  if (!composerKnown) return { mode: 'unknown', switcher, chatRole, chatLabel };
+  if (chats.length || works.length) {
+    return { mode: switcher && chatActive && !workActive ? 'chat' : 'unknown', switcher, chatRole, chatLabel };
+  }
+  // Known classic Chat has its own model picker. Generic effort controls and
+  // the absence of Work UI are insufficient on an unknown/new page layout.
+  const classicPickers = Array.from(document.querySelectorAll('button[data-testid="model-switcher-dropdown-button"]')).filter(visible);
