{
  "name": "chatgpt-to-claude",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup": "corepack pnpm install",
    "check": "corepack pnpm build && corepack pnpm test && corepack pnpm typecheck",
    "dev": "corepack pnpm build && corepack pnpm --filter @chatgpt-to-claude/api dev",
    "build": "node scripts/build.mjs",
    "test": "vitest run && node --test scripts/build-cache.test.mjs",
    "typecheck": "corepack pnpm -r typecheck",
    "package:release": "node scripts/packaging/release.mjs",
    "package:smoke": "node scripts/packaging/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "playwright-core": "1.63.0",
    "tar": "7.5.22",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vitest": "^4.1.11",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "license": "MIT"
}
