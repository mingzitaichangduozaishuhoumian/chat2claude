{
  "name": "chatgpt-to-claude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "start": "corepack pnpm --filter @chatgpt-to-claude/api dev",
