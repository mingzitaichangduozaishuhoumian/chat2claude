# Copy this file to .env for local overrides if desired.
# docker-compose.yml reads this file as an env_file so documented defaults are visible.

# Server bind settings
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated API keys for /v1/*.
# Leave empty for local development and enable a runtime dev key from /admin.
API_KEYS=

# Mock backend text prefix
MOCK_RESPONSE_PREFIX=Echo:

# Global fallback defaults used only when a request/model does not provide values.
DEFAULT_REASONING_EFFORT=medium
DEFAULT_RESPONSE_SPEED=balanced

# Optional: override editable model registry config with JSON.
# Example shape: {"models":[{"id":"custom","display_name":"Custom","claudeModel":"claude-model","backendModel":"backend-model","enabled":true,"defaults":{"reasoning_effort":"medium","speed":"balanced"}}]}
# MODEL_REGISTRY_JSON=
