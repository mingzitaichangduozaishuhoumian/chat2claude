# 普通用户启动脚本默认会设置 CHATGPT_BACKEND=session；代码层 loadEnv 默认仍是 mock，保护测试与本地开发。
CHATGPT_BACKEND=session
CHATGPT_BASE_URL=https://chatgpt.com
# 可选：预置独立网页网关；需自行部署并完成网页登录，管理台“模型映射 → 上游选择”也可配置。
# CHATGPT_ROUTING_MODE 可用 auto/codex/web，默认 codex；手动模式严格限定上游。
# 自动模式默认网页优先，可选 web/codex；纯 web 模式禁止 Codex 回退。不默认让两个后端协作。
# 模型填写网关真实 slug；默认 auto 不是通配符。工具、图片输入能力默认 false，仅确认网关支持时开启。
# 网关只需 Chat Completions，无需 /models。base URL 可包含 /v1；不要填写完整 /chat/completions 路径。
# CHATGPT_ROUTING_MODE=auto
# CHATGPT_AUTO_PREFERENCE=web
# CHATGPT_WEB_ENABLED=false # 关闭网页但保留配置；优先于自动路由和请求头覆盖
# CHATGPT_WEB_BASE_URL=http://127.0.0.1:8000
# CHATGPT_WEB_API_KEY=<gateway-api-key>
# CHATGPT_WEB_MODELS=auto
# CHATGPT_WEB_SUPPORTS_TOOLS=false
# CHATGPT_WEB_SUPPORTS_IMAGES=false
# 可选 JSON：明确将客户端型号或 alias 改用指定网页型号，并非声明型号等价。留空/{} 无映射。
# CHATGPT_WEB_MODEL_MAPPINGS={"sonnet":"auto","opus":"auto"}
# 管理台 Key 留空保留；清除网页配置会清理 Key。服务端 runtime-state 可用 STATE_ENCRYPTION_KEY 加密。
# 可选：覆盖模型目录请求的 Codex 客户端版本。未设置时使用服务维护的兼容基线。
# 旧版本可能使上游目录缺少新模型；修改后需重启服务并刷新账号模型。
# CODEX_CLIENT_VERSION=0.160.0
# OAuth/short operations timeout.
CHATGPT_REQUEST_TIMEOUT_MS=60000
# Independent Images API generation/read timeout; integer 1..2147483647 ms.
CHATGPT_IMAGE_REQUEST_TIMEOUT_MS=300000
# Response header timeout.
CHATGPT_RESPONSE_HEADER_TIMEOUT_MS=60000
# Non-sliding timeout after successful headers while waiting for the first valid supported SSE frame.
CHATGPT_STREAM_BOOTSTRAP_TIMEOUT_MS=60000
# Stream idle timeout.
CHATGPT_STREAM_IDLE_TIMEOUT_MS=300000
# 0 disables absolute total timeout.
CHATGPT_STREAM_TOTAL_TIMEOUT_MS=0
SSE_KEEPALIVE_INTERVAL_MS=15000

PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
DEFAULT_REASONING_EFFORT=medium
DEFAULT_RESPONSE_SPEED=balanced

# 可选：预置静态 API key。未设置时，本机 /admin 会建立进程级 HttpOnly 管理会话；一键授权完成后生成持久化 Runtime API Key。
# Runtime API Key 供 Claude Code 和 /v1/* 客户端使用；不会从已持久化 Key 重新显示原始值。
# API_KEYS=sk-local-1,sk-local-2

# 可选：runtime-state.json 的目录；相对路径会按当前工作目录解析。
# DATA_DIR=./custom-data

# 可选：以 AES-256-GCM 加密 runtime-state.json。值必须是无空白、严格标准 base64 编码的 32 字节密钥（44 个字符、末尾一个 =）；不要留空。
# 生成密钥：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

# 仅供 docker-compose 的本机回环端口发布。不要在公网部署中启用。
# LOCAL_CONTAINER_BOOTSTRAP=true

# 可选：Chrome 授权流配置。CDP 只绑定 127.0.0.1。
# CHATGPT_AUTH_CDP_PORT=9222
# CHATGPT_AUTH_CHROME_PROFILE_DIR=data/chrome-profile
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# mock backend 开发/测试可用
# CHATGPT_BACKEND=mock
# MOCK_BACKEND_MODELS_JSON=[{"id":"backend-test-model","displayName":"Backend Test Model"}]

# Access-log format: text (default), detailed, or json; simple is a text alias.
ACCESS_LOG_FORMAT=text
