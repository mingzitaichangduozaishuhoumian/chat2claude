# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# /v1/* auth. Comma-separated; alternatively enable a runtime dev key from /admin.
API_KEYS=

# Backend provider. mock is the safe default and does not contact ChatGPT.
CHATGPT_BACKEND=mock
CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_REQUEST_TIMEOUT_MS=60000

# Mock backend discovery/response customization.
MOCK_RESPONSE_PREFIX=Echo:
# MOCK_BACKEND_MODELS_JSON=[{"id":"backend-test-model","displayName":"Backend Test Model"}]

# Model alias overlay and request defaults.
# MODEL_REGISTRY_JSON={"aliases":[{"id":"sonnet","backendModel":"backend-test-model"}]}
DEFAULT_REASONING_EFFORT=medium
DEFAULT_RESPONSE_SPEED=balanced

# Alpha real-session mode:
# 1. Set CHATGPT_BACKEND=session.
# 2. Start the API and open /admin.
# 3. Manually import a ChatGPT session account with accessToken/cookie/deviceId/userAgent.
# Secrets are in-memory only and admin list responses expose only hasSecret.
